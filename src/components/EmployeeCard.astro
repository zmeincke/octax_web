---
const { image, name, role, phonenumber, email, phone } = Astro.props;
---
<div class="container">
    <figure><img src={image} alt="Personal employee icon"></figure>
    <div>
        <h3>{name}</h3>
        <p>{role}</p>
        <dl>
            <dt class={`${phone}`}>Tlf nr.:</dt>
            <dd>{phonenumber}</dd>
            <dt>Email:</dt>
            <dd>{email}</dd>
        </dl>
    </div>
</div>

<style>
   div.container {
    width: 15rem;
    display: flex;
    flex-direction: column;
    figure {
        width: 10rem;
        height: auto;
        align-self: center;
    }
    h3 {
        font-size: 1.5rem;
        margin-top: 0.5rem;
    }
    p {
        font-size: 0.8rem;
        margin-bottom: 1rem;
    }
    dl {
        display: flex;
        flex-direction: column;
        gap: 0.5rem 2rem;
        font-family: var(--textfont);
        dt {
            font-size: 1rem;
            font-weight: 800;
            color: var(--accentcolor);
        }
        dd {
            font-size: 1.5rem;
        }
        dt.hide {
            display: none;
        }
    }
   } 
</style>