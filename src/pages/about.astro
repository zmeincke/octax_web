---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import EmployeeCard from "../components/EmployeeCard.astro";
import Button from "../components/Button.astro";
---

<Layout>
    <Hero
    title="Om os"
    text="OctaX I/S er et eventfirma, der blev skabt ud fra en fælles vision, om at give en masse fede oplevelser til børn og unge (og voksne) igennem læring og leg. Vi brænder for at udvikle og afvikle nye, spændende og lærerige events, der listigt forklæder vigtige kompetencer som sjove og engagerende udfordringer."
    img="/img/about.png"
    alt="picture of a group activity"/>
    <div class="pagelayout">
        <section class="about">
            <div>
                <h2>Vores værdier</h2>
                <dl>
                    <dt>Our belief</dt>
                    <dd>Vi tror på, at de bedste læringsøjeblikke opstår, når man udfordres , intellektuelt fysisk og socialt i trygge og spændende rammer.</dd>
                    <dt>Samarbejde</dt>
                    <dd>Vi tror på, at de bedste events skabes gennem tæt samarbejde med vores kunder. Vi lytter til jeres ønsker og arbejder sammen for at realisere jeres vision.</dd>
                    <dt>Innovation</dt>
                    <dd>Vi specialiserer os i at skabe autentiske og intense live-events, der tvinger deltagerne til at være på dupperne, tænke strategisk. Vores events er designet til at teste jeres sociale evner, kritiske tænkning og evnen til samarbejde.</dd>
                    <dt>Kreativitet</dt>
                    <dd>Vi er altid på udkig efter nye og kreative måder at forbedre vores events på. Vi omfavner innovation og teknologi for at skabe unikke oplevelser, der skiller sig ud.</dd>
                    <dt>Kvalitet</dt>
                    <dd>Vi går aldrig på kompromis med kvaliteten af vores arbejde. Fra planlægning til udførelse sikrer vi, at hvert aspekt af jeres event er af højeste standard.</dd>
                </dl>
            </div>
            <div>
                <h2>Hvad laver vi</h2>
                <p>Vi specialiserer os i at skabe autentiske og intense live-events, der tvinger deltagerne til at være på dupperne, tænke strategisk. Vores events er designet til at teste jeres sociale evner, kritiske tænkning og evnen til samarbejde.</p>
            </div>
            <div>
                <h2>Vores team</h2>
                <div>
                    <p>Vores team er dedikeret til at tænke uden for boksen og bringe innovative ideer til bordet. Vi stræber efter at skabe unikke oplevelser, der skiller sig ud.</p>
                </div>
            </div>
            <div>
                <h2>Historie</h2>
                <p>OctaX I/S blev stiftet i 2025 af tre passionerede ... med mange års erfaring inden for ....</p>
            </div>
        </section>
        <figure class="divider"></figure>
        <aside>
            <h2>Kontakt</h2>
            <section class="employees">
                <EmployeeCard image="/svg/icon-contact-j.svg" name="Jesper Hesselberg" role="Medstifter, Kom. & Kundekontakt" phonenumber="+45 25 77 18 08" email="info@octax.dk"/>
                <EmployeeCard image="/svg/icon-contact-v.svg" name="Viktor Mantzius" role="Medstifter, IT & Økonomi" phonenumber="+45 22 42 68 14" email="kasser@octax.dk"/>
                <EmployeeCard image="/svg/icon-contact-z.svg" name="Zasia V. Meincke" role="Medstifter, HR & Marketing" email="pr@octax.dk", phone="hide"/>
            </section>
            <form>
                <h3>Event booking</h3>
                <figure class="line"></figure>
                <div>
                    <label for="name">Navn:</label>
                    <input type="text" id="name" name="name" placeholder="OctaX I/S">
                </div>
                <div>
                    <div>
                        <label for="phone">Telefonnummer:</label>
                        <input type="tel" id="phone" name="phone" placeholder="+45 XX XX XX XX">
                    </div>
                    <div>
                        <label for="email">Email:</label>
                        <input type="email" id="email" name="email" placeholder="test@gmail.com" required>
                    </div>
                </div>
                <div>
                    <label for="message">Besked:</label>
                    <textarea id="message" name="message" rows="4" placeholder="Skriv din besked her..." required></textarea> 
                </div>
                <Button text="Send" href="#"/>
            </form>
        </aside>
    </div>
</Layout>

<style>
    :global(img.heroImage) {
    margin-top: -24rem;
    }
    div.pagelayout {
        display: flex;
        justify-content: space-between;
        gap: 3rem;
        margin: 4rem 10rem;

        figure.divider {
            width: 0.5rem;
            height: 118vh;
            background-color: var(--accentcolor);
        }
    }
    section.about {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        h2 {
            margin-bottom: 0.25rem;
            font-size: 2rem;
            color: var(--accentcolor);
        }
        dt {
            font-weight: 900;
            font-size: 1.25rem;
        }
        dd {
            margin-bottom: 1rem;
        }
    }
    aside {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        width: 180rem;
        h2 {
            font-size: 2rem;
        }
    }
    .employees {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
    }
    form {
        display: flex;
        flex-direction: column;
        gap: 2rem;
        background-color: var(--secondarybgcolor);
        padding: 4rem 5rem;
        margin-top: 4rem;
        border-radius: 1rem;
        font-family: var(--textfont);
        figure.line {
            width: 100%;
            height: 0.1rem;
            background-color: var(--accentcolor);
            margin: -0.5rem 0 1rem 0;
        }
        >div {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            label {
                font-weight: 800;
                margin-left: 0.5rem;
            }
            input, textarea {
                padding: 1rem;
                background-color: var(--primarybgcolor);
                border-radius: 0.8rem;
                border: none;
                font-family: var(--textfont);
                font-size: 1rem;
            }
        }
        >div:nth-child(4) {
            flex-direction: row;
            gap: 1rem;
            div {
                display: flex;
                flex-direction: column;
                gap: 0.5rem;
                width: 100%;
            }
        }
        >:last-child {
            margin-top: 1.5rem;
        }
    }
</style>